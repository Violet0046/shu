# 复制为 .env；或通过 SHU_ENV_FILE 指定绝对路径。不要提交真实配置。
SHU_AI_PROVIDER=doubao
SHU_AI_MODEL=doubao-seed-2-1-lite-260915
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
SHU_WEB_HOST=127.0.0.1
SHU_WEB_PORT=8000
# web、worker 和账号管理命令必须使用相同的持久目录。
SHU_WEB_DATA_DIR=/var/lib/shu
SHU_PUBLIC_URL=https://your-domain.example
SHU_COOKIE_SECURE=1
SHU_WEB_MAX_TOKENS=6000
# 豆包适配器固定使用 Responses、高细节图片、关闭思考。
SHU_WORKER_CONCURRENCY=2
SHU_JOB_LEASE_SECONDS=120
SHU_JOB_MAX_ATTEMPTS=3
